# Copy to .env and edit. None of these are required for v1 to run.

# Where the SQLite DB lives. Default = ./data/jobhunt.db
JOBHUNT_DB_PATH=./data/jobhunt.db

# Polite scraper config
JOBHUNT_USER_AGENT="jobhunt/0.1 (+https://github.com/Ziad-Abdalla/jobhunt)"
JOBHUNT_REQUEST_TIMEOUT=20
JOBHUNT_CONCURRENCY=4

# How many days a posting stays in the DB after we stop seeing it on the source.
JOBHUNT_STALE_AFTER_DAYS=14

# UI
JOBHUNT_HOST=127.0.0.1
JOBHUNT_PORT=8765

# Optional: Jooble API key for global job search (69 countries). Free at https://jooble.org/api/about
JOBHUNT_JOOBLE_API_KEY=
# Optional: Reed.co.uk API key for UK jobs. Free at https://www.reed.co.uk/developers/jobseeker
JOBHUNT_REED_API_KEY=

# Your location — when set, automatically fetches local software jobs for your area.
# Examples: "London, UK", "Berlin, Germany", "Cairo, Egypt", "Doha, Qatar"
JOBHUNT_USER_LOCATION=
