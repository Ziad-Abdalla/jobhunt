# Copy to .env and edit. None of these are required for v1 to run.

# Where the SQLite DB lives. Default = ./data/jobhunt.db
JOBHUNT_DB_PATH=./data/jobhunt.db

# Polite scraper config
JOBHUNT_USER_AGENT="jobhunt/0.1 (+https://github.com/Abdalla2004-collab/Jobhunt)"
JOBHUNT_REQUEST_TIMEOUT=20
JOBHUNT_CONCURRENCY=4

# How many days a posting stays in the DB after we stop seeing it on the source.
JOBHUNT_STALE_AFTER_DAYS=14

# UI
JOBHUNT_HOST=127.0.0.1
JOBHUNT_PORT=8765
